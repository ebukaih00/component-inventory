{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "typeRoots": ["../node_modules/@figma", "../node_modules/@types"],
    "types": ["plugin-typings"]
  },
  "include": ["src/*.ts"]
}
