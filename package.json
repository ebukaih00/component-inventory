{
  "name": "component-inventory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension that inventories your product's UI, clusters near-identical components and exports a Figma board.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "CI_E2E=1 vite build --outDir dist-e2e",
    "build:spike": "vite build --config vite.spike.config.ts",
    "build:figma": "node scripts/build-figma.mjs",
    "fixtures:serve": "http-server fixtures/site -p 4173 -c-1",
    "fixtures:snapshot": "npm run build:spike && node scripts/snapshot-fixtures.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p figma-plugin",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:e2e && playwright test",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@figma/plugin-typings": "^1.142.0",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.7",
    "http-server": "^14.1.1",
    "idb": "^8.0.4",
    "preact": "^10.29.8",
    "typescript": "~5.9",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
